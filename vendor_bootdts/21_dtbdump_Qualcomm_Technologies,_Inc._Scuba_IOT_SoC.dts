			phandle = <0x49>;
			reusable;
			size = <0x0 0x1000000>;
		};

		video_region@53617000 {
			no-map;
			phandle = <0xf1>;
			reg = <0x0 0x53617000 0x0 0x700000>;
		};

		wlan_msa_region@51900000 {
			no-map;
			phandle = <0xed>;
			reg = <0x0 0x51900000 0x0 0x100000>;
		};

		xbl_aop_mem@45e00000 {
			no-map;
			phandle = <0xeb>;
			reg = <0x0 0x45e00000 0x0 0x100000>;
		};
	};

	soc {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "simple-bus";
		phandle = <0xf5>;
		ranges = <0x0 0x0 0x0 0xffffffff>;

		apps-smmu@0xc600000 {
			#address-cells = <0x1>;
			#global-interrupts = <0x1>;
			#iommu-cells = <0x2>;
			#size-cells = <0x1>;
			compatible = "qcom,qsmmu-v500";
