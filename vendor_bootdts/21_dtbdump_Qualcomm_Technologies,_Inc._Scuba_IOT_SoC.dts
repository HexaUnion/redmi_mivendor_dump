	aliases {
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a8c000";
		mmc0 = "/soc/sdhci@4744000";
		mmc1 = "/soc/sdhci@4784000";
		phandle = <0xdf>;
		serial0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a90000";
	};

	chosen {
		bootargs = "lpm_levels.sleep_disabled=1 console=ttyMSM0,115200n8 msm_rtb.filter=0x237 service_locator.enable=1 swiotlb=2048 loop.max_part=7 cpufreq.default_governor=performance rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off export_pmu_events movable_node ftrace_dump_on_oops disable_dma32=on cgroup.memory=nokmem,nosocket panic=5";
	};

	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0xa>;
				};

				core1 {
					cpu = <0xb>;
				};

				core2 {
					cpu = <0xc>;
				};

				core3 {
					cpu = <0xd>;
				};
			};
		};

		cpu@0 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			cpu-idle-states = <0x2>;
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x4>;
			phandle = <0xa>;
			power-domain-names = "psci";
			power-domains = <0x3>;
			qcom,freq-domain = <0x5 0x0 0x4>;
			qcom,lmh-dcvs = <0x6>;
			reg = <0x0 0x0>;

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe1>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe0>;
			};

			l2-cache {
				cache-level = <0x2>;
				compatible = "arm,arch-cache";
				phandle = <0x4>;
			};
		};

		cpu@1 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			cpu-idle-states = <0x2>;
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x4>;
			phandle = <0xb>;
			power-domain-names = "psci";
			power-domains = <0x7>;
			qcom,freq-domain = <0x5 0x0 0x4>;
			qcom,lmh-dcvs = <0x6>;
			reg = <0x0 0x1>;

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe3>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe2>;
			};
		};

		cpu@2 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			cpu-idle-states = <0x2>;
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x4>;
			phandle = <0xc>;
			power-domain-names = "psci";
			power-domains = <0x8>;
			qcom,freq-domain = <0x5 0x0 0x4>;
			qcom,lmh-dcvs = <0x6>;
			reg = <0x0 0x2>;

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe5>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe4>;
			};
		};

		cpu@3 {
			capacity-dmips-mhz = <0x400>;
			compatible = "arm,armv8";
			cpu-idle-states = <0x2>;
			device_type = "cpu";
			dynamic-power-coefficient = <0x64>;
			enable-method = "psci";
			next-level-cache = <0x4>;
			phandle = <0xd>;
			power-domain-names = "psci";
			power-domains = <0x9>;
			qcom,freq-domain = <0x5 0x0 0x4>;
			qcom,lmh-dcvs = <0x6>;
			reg = <0x0 0x3>;

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe7>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe6>;
			};
		};
	};

	firmware {
		phandle = <0xe8>;

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/4744000.sdhci/by-name/vendor";
					fsmgr_flags = "wait,slotselect,avb";
					mnt_flags = "ro,barrier=1,discard";
					status = "ok";
					type = "ext4";
				};
			};

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};
		};

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x10 0x13000>;
		};
	};

	idle-states {

		silver-c3 {
			arm,psci-suspend-param = <0x40000003>;
			compatible = "arm,idle-state";
			entry-latency-us = <0x129>;
			exit-latency-us = <0x144>;
			idle-state-name = "pc";
			local-timer-stop;
			min-residency-us = <0x456>;
			phandle = <0x2>;
		};

		silver-cluster-d3 {
			arm,psci-suspend-param = <0x41000043>;
			compatible = "domain-idle-state";
			entry-latency-us = <0x320>;
			exit-latency-us = <0x846>;
			idle-state-name = "pwr-l2-pc";
			min-residency-us = <0x1cd0>;
			phandle = <0xf>;
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		granule = <0x200>;
		offline-sizes = <0x1 0x40000000 0x0 0x40000000 0x1 0xc0000000 0x0 0x80000000 0x2 0xc0000000 0x1 0x40000000>;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x0>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cluster-pd0 {
			#power-domain-cells = <0x0>;
			domain-idle-states = <0xf>;
			phandle = <0xe>;
		};

		cpu-pd0 {
			#power-domain-cells = <0x0>;
			phandle = <0x3>;
			power-domains = <0xe>;
		};

		cpu-pd1 {
			#power-domain-cells = <0x0>;
			phandle = <0x7>;
			power-domains = <0xe>;
		};

		cpu-pd2 {
			#power-domain-cells = <0x0>;
			phandle = <0x8>;
			power-domains = <0xe>;
		};

		cpu-pd3 {
			#power-domain-cells = <0x0>;
			phandle = <0x9>;
			power-domains = <0xe>;
		};
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		phandle = <0xe9>;
		ranges;

		adsp_region {
			alignment = <0x0 0x400000>;
			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0x4d>;
			reusable;
			size = <0x0 0x800000>;
		};

		adsp_regions@51a00000 {
			no-map;
			phandle = <0x1a>;
			reg = <0x0 0x51a00000 0x0 0x1c00000>;
		};

		audio_cma_region {
			alignment = <0x0 0x400000>;
			alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
			compatible = "shared-dma-pool";
			phandle = <0xf4>;
			reusable;
			size = <0x0 0x1c00000>;
		};

		dfps_data_region@5cf00000 {
			label = "dfps_data_region";
			phandle = <0x1ec>;
			reg = <0x0 0x5cf00000 0x0 0x100000>;
		};

		gpu_region@53615000 {
			no-map;
			phandle = <0xf0>;
			reg = <0x0 0x53615000 0x0 0x2000>;
		};

		hyp_region@45700000 {
			no-map;
			phandle = <0xea>;
