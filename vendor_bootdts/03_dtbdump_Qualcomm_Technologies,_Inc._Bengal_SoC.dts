				qcom,lpi-slew-offset-tbl = <0x0 0x2 0x4 0x8 0xa 0xc 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x14>;
				qcom,slew-reg = <0xa95a000 0x0>;
				reg = <0xa7c0000 0x0>;

				dmic01_clk_active {
					phandle = <0x24a>;

					config {
						drive-strength = <0x8>;
						output-high;
						pins = "gpio6";
