					phandle = <0x59>;
					reg = <0x3400>;

					camera_flash_therm {
						io-channels = <0x6f 0x52>;
						reg = <0x0>;
					};

					emmc_ufs_therm {
						io-channels = <0x6f 0x53>;
						reg = <0x1>;
					};
				};

				adc_tm@3500 {
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					#thermal-sensor-cells = <0x1>;
					compatible = "qcom,spmi-adc-tm5";
					interrupt-names = "pm-adc-tm5";
					interrupts = <0x0 0x35 0x0 0x1>;
					phandle = <0x58>;
					reg = <0x3500>;

					pa_therm0 {
						io-channels = <0x6f 0x4d>;
						qcom,hw-settle-time-us = <0xc8>;
						qcom,ratiometric;
						reg = <0x0>;
					};

					quiet_therm {
						io-channels = <0x6f 0x4e>;
						qcom,hw-settle-time-us = <0xc8>;
						qcom,ratiometric;
						reg = <0x1>;
					};

					xo_therm {
						io-channels = <0x6f 0x4c>;
						qcom,hw-settle-time-us = <0xc8>;
						qcom,ratiometric;
						reg = <0x2>;
					};
				};

				clock-controller@5b00 {
					#clock-cells = <0x1>;
					assigned-clock-rates = <0x927c00>;
					assigned-clocks = <0x70 0x1>;
					clock-names = "xo";
					clock-output-names = "pm6125_div_clk1";
					clocks = <0x1c 0x0>;
					compatible = "qcom,spmi-clkdiv";
					phandle = <0x70>;
					qcom,num-clkdivs = <0x1>;
					reg = <0x5b00>;
				};

				pinctrl@c000 {
					#gpio-cells = <0x2>;
					#interrupt-cells = <0x2>;
					compatible = "qcom,pm6125-gpio";
					gpio-controller;
					interrupt-controller;
					phandle = <0x182>;
					reg = <0xc000>;

					camera_therm {

						camera_therm_default {
							bias-high-impedance;
							phandle = <0x6d>;
							pins = "gpio3";
						};
					};

					emmc_therm {

						emmc_therm_default {
							bias-high-impedance;
							phandle = <0x6e>;
							pins = "gpio4";
						};
					};
				};

