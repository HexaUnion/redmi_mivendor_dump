				};

				dmic01_clk_sleep {
					phandle = <0x24c>;

					config {
						bias-disable;
						drive-strength = <0x2>;
						output-low;
						pins = "gpio6";
					};

					mux {
						function = "func1";
						pins = "gpio6";
					};
				};

				dmic01_data_active {
					phandle = <0x24b>;

					config {
						drive-strength = <0x8>;
						input-enable;
						pins = "gpio7";
					};

					mux {
						function = "func1";
						pins = "gpio7";
					};
				};

				dmic01_data_sleep {
					phandle = <0x24d>;

					config {
						drive-strength = <0x2>;
						input-enable;
						pins = "gpio7";
						pull-down;
					};

					mux {
						function = "func1";
						pins = "gpio7";
					};
				};

				dmic23_clk_active {
					phandle = <0x24e>;

					config {
						drive-strength = <0x8>;
						output-high;
						pins = "gpio8";
					};

