				dmic23_data_sleep {
					phandle = <0x251>;

					config {
						drive-strength = <0x2>;
						input-enable;
						pins = "gpio9";
						pull-down;
					};

					mux {
						function = "func1";
						pins = "gpio9";
					};
				};

				lpi_aux1_sck {

					lpi_aux1_sck_active {
						phandle = <0x2bb>;

						config {
							bias-disable;
							drive-strength = <0x8>;
							output-high;
							pins = "gpio6";
						};

						mux {
							function = "func2";
							pins = "gpio6";
						};
					};

					lpi_aux1_sck_sleep {
						phandle = <0x2ba>;

						config {
							bias-pull-down;
							drive-strength = <0x2>;
							input-enable;
							pins = "gpio6";
						};

						mux {
