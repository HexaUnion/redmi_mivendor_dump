			arm,primecell-periphid = <0xbb968>;
			clock-names = "apb_pclk";
			clocks = <0x1c 0x8>;
			compatible = "arm,primecell";
			coresight-name = "coresight-tpdm-apss";
			phandle = <0x1b3>;
			reg = <0x9860000 0x1000>;
			reg-names = "tpdm-base";

			out-ports {

				port {

					endpoint {
						phandle = <0xb4>;
						remote-endpoint = <0xa7>;
					};
				};
			};
		};

		tpdm@98a0000 {
			arm,primecell-periphid = <0xbb968>;
			clock-names = "apb_pclk";
			clocks = <0x1c 0x8>;
			compatible = "arm,primecell";
			coresight-name = "coresight-tpdm-llm-silver";
			phandle = <0x1b2>;
			reg = <0x98a0000 0x1000>;
			reg-names = "tpdm-base";

			out-ports {

				port {

					endpoint {
						phandle = <0xb6>;
						remote-endpoint = <0xa6>;
					};
				};
			};
		};

		tsens@c222000 {
			#thermal-sensor-cells = <0x1>;
			compatible = "qcom,tsens24xx";
			interrupt-names = "tsens-upper-lower", "tsens-critical";
			interrupts = <0x0 0x113 0x4 0x0 0xbe 0x4>;
			interrupts-extended = <0x1 0x0 0x113 0x4 0x5a 0x2 0x4>;
			phandle = <0x3d>;
			reg = <0x4410000 0x8 0x4411000 0x1ff>;
			reg-names = "tsens_srot_physical", "tsens_tm_physical";
			tsens-reinit-wa;
		};

		turing_etm0 {
			compatible = "qcom,coresight-remote-etm";
			coresight-name = "coresight-turing-etm0";
			phandle = <0xc3>;
			qcom,inst-id = <0xd>;

			out-ports {

				port {

					endpoint {
						phandle = <0xc5>;
						remote-endpoint = <0x93>;
					};
				};
			};
		};

		tz-log@c125720 {
			compatible = "qcom,tz-log";
			hyplog-address-offset = <0x410>;
			hyplog-size-offset = <0x414>;
			phandle = <0x153>;
			qcom,hyplog-enabled;
			reg = <0xc125720 0x3000>;
		};

		ufshc@4804000 {
			#reset-cells = <0x1>;
			clock-names = "core_clk", "bus_aggr_clk", "iface_clk", "core_clk_unipro", "core_clk_ice", "ref_clk", "tx_lane0_sync_clk", "rx_lane0_sync_clk";
			clocks = <0x1d 0x76 0x1d 0x73 0x1d 0x75 0x1d 0x7e 0x1d 0x78 0x1c 0x0 0x1d 0x7d 0x1d 0x7c>;
			compatible = "qcom,ufshc";
			freq-table-hz = <0x2faf080 0xbebc200 0x0 0x0 0x0 0x0 0x23c3460 0x8f0d180 0x47868c0 0x11e1a300 0x0 0x0 0x0 0x0 0x0 0x0>;
			interconnect-names = "ufs-ddr", "cpu-ufs";
			interconnects = <0x28 0x1d 0x26 0x200 0x26 0x0 0x27 0x23e>;
			interrupts = <0x0 0x164 0x4>;
			iommus = <0x29 0x100 0x0>;
			lanes-per-direction = <0x1>;
			limit-phy-submode = <0x0>;
			non-removable;
			nvmem-cell-names = "boot_conf";
			nvmem-cells = <0x37>;
			phandle = <0x3a>;
			phy-names = "ufsphy";
			phys = <0x3b>;
			qcom,bus-vector-names = "MIN", "PWM_G1_L1", "PWM_G2_L1", "PWM_G3_L1", "PWM_G4_L1", "HS_RA_G1_L1", "HS_RA_G2_L1", "HS_RA_G3_L1", "HS_RB_G1_L1", "HS_RB_G2_L1", "HS_RB_G3_L1", "MAX";
			qcom,dynamic-irq-affinity;
			qcom,iommu-dma = "fastmap";
			qcom,ufs-bus-bw,name = "ufshc_mem";
			qcom,ufs-bus-bw,num-cases = <0xc>;
			qcom,ufs-bus-bw,num-paths = <0x2>;
			qcom,ufs-bus-bw,vectors-KBps = <0x7b 0x200 0x0 0x0 0x1 0x2f5 0x0 0x0 0x7b 0x200 0x39a 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x734 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0xe68 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x1cd0 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x1f334 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x3e667 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x200000 0x0 0x1 0x2f5 0x19000 0x0 0x7b 0x200 0x247ae 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x48ccd 0x0 0x1 0x2f5 0x3e8 0x0 0x7b 0x200 0x200000 0x0 0x1 0x2f5 0x19000 0x0 0x7b 0x200 0x74a000 0x0 0x1 0x2f5 0x4b000 0x0>;
			reg = <0x4804000 0x3000 0x4810000 0x8000>;
			reg-names = "ufs_mem", "ufs_ice";
			reset-names = "core_reset";
			resets = <0x1d 0x3>;
			status = "disabled";

			qos0 {
				perf;
				vote = <0x2c>;
			};

			qos1 {
				vote = <0x2c>;
			};
		};

		ufsphy_mem@4807000 {
			#phy-cells = <0x0>;
			clock-names = "ref_clk_src", "ref_clk", "ref_aux_clk";
			clocks = <0x1c 0x0 0x1d 0xa5 0x1d 0x7a>;
			lanes-per-direction = <0x1>;
			phandle = <0x3b>;
			reg = <0x4807000 0xdb8>;
			reg-names = "phy_mem";
			resets = <0x3a 0x0>;
			status = "disabled";
		};

		usb_audio_qmi_dev {
			compatible = "qcom,usb-audio-qmi-dev";
			iommus = <0x29 0x1cf 0x0>;
			qcom,iommu-dma = "disabled";
			qcom,usb-audio-intr-num = <0x2>;
			qcom,usb-audio-stream-id = <0xf>;
		};

		usb_nop_phy {
			compatible = "usb-nop-xceiv";
			phandle = <0x196>;
		};

		va_mini_dump {
			compatible = "qcom,va-minidump";
			memory-region = <0x61>;
			status = "ok";
		};

		vote_lpass_audio_hw {
			#clock-cells = <0x1>;
			compatible = "qcom,audio-ref-clk";
			phandle = <0x249>;
			qcom,codec-ext-clk-src = <0xb>;
		};

		xiaomi_fingerprint {
			compatible = "xiaomi-fingerprint";
			fingerprint,name = "xiaomi-fingerprint";
			status = "ok";
		};
	};
};
