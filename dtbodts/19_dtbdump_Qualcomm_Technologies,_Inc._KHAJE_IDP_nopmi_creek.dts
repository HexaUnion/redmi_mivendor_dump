					sc,ibat-ocp-dis = <0x0>;
					sc,ico-enable = <0x0>;
					sc,iindpm-disable = <0x0>;
					sc,iindpm-ico = <0x64>;
					sc,input-curr-limit = <0xbb8>;
					sc,precharge-curr = <0xfa>;
					sc,precharge-volt = <0x1>;
					sc,rechg-dg = <0x0>;
					sc,rechg-dis = <0x1>;
					sc,rechg-volt = <0x0>;
					sc,term-curr = <0x44c>;
