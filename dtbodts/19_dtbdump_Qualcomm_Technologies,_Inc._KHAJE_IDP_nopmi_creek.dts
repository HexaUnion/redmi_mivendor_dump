	fragment@27 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_pwm {

				irled_pwm_active {
					phandle = <0xe>;

					config {
						drive-strength = <0x4>;
						pins = "gpio69";
					};

					mux {
						function = "GCC_GP2";
