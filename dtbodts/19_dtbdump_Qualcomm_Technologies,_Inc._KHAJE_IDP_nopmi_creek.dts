			};

			cam-vio {
				compatible = "regulator-fixed";
				enable-active-high;
				gpio = <0xffffffff 0x36 0x0>;
				phandle = <0x47>;
				pinctrl-0 = <0xffffffff 0xffffffff>;
				pinctrl-names = "vio_active", "vio_suspend";
				regulator-max-microvolt = <0x1b7740>;
				regulator-min-microvolt = <0x1b7740>;
				regulator-name = "cam_vio_1p8";
				status = "okay";
			};

			qcom,cam-res-mgr {
				compatible = "qcom,cam-res-mgr";
				phandle = <0x4c>;
				status = "ok";
			};
		};
