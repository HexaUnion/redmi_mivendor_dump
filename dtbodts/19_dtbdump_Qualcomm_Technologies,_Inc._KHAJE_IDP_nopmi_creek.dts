	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			eldo9_pin {

				gpio@c000 {
					bias-disable;
					function = "normal";
					output-high;
					phandle = <0x4>;
					pins = "gpio1";
					power-source = <0x0>;
					qcom,drive-strength = <0x2>;
				};
			};

			key_vol_up {

				key_vol_up_default {
					bias-pull-up;
					function = "normal";
					input-enable;
					phandle = <0x2>;
					pins = "gpio5";
					power-source = <0x0>;
				};
			};

			rf_pa1_therm {

				rf_pa1_therm_default {
					bias-high-impedance;
					phandle = <0x1>;
					pins = "gpio7";
				};
			};

			vib_out_gpio8 {

				vib_out_gpio8_default {
					bias-pull-up;
					function = "normal";
					phandle = <0x3>;
					pins = "gpio8";
					power-source = <0x0>;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-0 = <0x2>;
				pinctrl-names = "default";

				vol_up {
					debounce-interval = <0xf>;
					gpio-key,wakeup;
					gpios = <0xffffffff 0x5 0x1>;
					label = "volume_up";
					linux,can-disable;
					linux,code = <0x73>;
					linux,input-type = <0x1>;
				};
			};

			vdda_usb_ss_dp_core {
				compatible = "regulator-fixed";
				enable-active-high;
				gpio = <0xffffffff 0x1 0x0>;
				phandle = <0x5>;
				pinctrl-0 = <0x4>;
				pinctrl-names = "default";
				regulator-max-microvolt = <0xd6d80>;
				regulator-min-microvolt = <0xd6d80>;
				regulator-name = "vdd_supply";
			};

			vibrator_gpio {
				compatible = "qcom,qpnp-vibrator-ldo";
				pinctrl-0 = <0x3>;
				pinctrl-names = "default";
				status = "ok";
				vib,en-gpio = <0xffffffff 0x8 0x1>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-supply = <0x5>;
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			awinic@64 {
				compatible = "awinic,aw2016_led";
				reg = <0x64>;

				awinic,blue {
					awinic,fall-time-ms = <0x6>;
					awinic,hold-time-ms = <0x0>;
					awinic,id = <0x2>;
					awinic,imax = <0x2>;
					awinic,led-current = <0x3>;
					awinic,max-brightness = <0xff>;
					awinic,name = "blue";
					awinic,off-time-ms = <0x4>;
					awinic,rise-time-ms = <0x6>;
				};

				awinic,green {
					awinic,fall-time-ms = <0x6>;
					awinic,hold-time-ms = <0x0>;
					awinic,id = <0x1>;
					awinic,imax = <0x2>;
					awinic,led-current = <0x3>;
					awinic,max-brightness = <0xff>;
					awinic,name = "green";
					awinic,off-time-ms = <0x4>;
					awinic,rise-time-ms = <0x6>;
				};

				awinic,red {
					awinic,fall-time-ms = <0x6>;
					awinic,hold-time-ms = <0x0>;
					awinic,id = <0x0>;
					awinic,imax = <0x2>;
					awinic,led-current = <0x3>;
					awinic,max-brightness = <0xff>;
					awinic,name = "red";
					awinic,off-time-ms = <0x4>;
					awinic,rise-time-ms = <0x6>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-0 = <0xffffffff>;
			pinctrl-1 = <0xffffffff>;
			pinctrl-names = "default", "sleep";
			qcom,vdd-current-level = <0x0 0x8b290>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-current-level = <0x0 0x4f588>;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			status = "ok";
			vdd-io-supply = <0xffffffff>;
			vdd-supply = <0xffffffff>;
		};
	};
};
